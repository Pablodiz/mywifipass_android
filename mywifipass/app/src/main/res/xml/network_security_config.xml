<?xml version="1.0" encoding="utf-8"?>
<!--
Network security configuration for self-hosted environments.

This configuration allows:
- HTTPS (secure) for production and remote deployments (DEFAULT and RECOMMENDED)
- HTTP only for:
  * Local development (127.0.0.1, localhost)
  * Private network self-hosted instances (192.168.x.x, 10.x.x.x)
  * Domain-based self-hosted (must use HTTPS - no exception)

For production self-hosted instances:
- ALWAYS use HTTPS with proper certificates
- Update your server configuration to use HTTPS
- Note: Self-signed certificates are supported via trust anchors

This approach supports the multi-tenant self-hosted model where:
- Same app connects to different servers
- Each organization deploys their own instance
- Development can use local HTTP, production must use HTTPS
-->
<network-security-config>
    <!-- Default domain configuration: HTTPS only (most secure) -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">*</domain>
    </domain-config>

    <!-- Local development exception: allow localhost HTTP -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
    </domain-config>

    <!-- Private network exception for self-hosted: allow 192.168.x.x HTTP -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">192.168.0.0/16</domain>
    </domain-config>

    <!-- Private network exception for self-hosted: allow 10.x.x.x HTTP -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.0.0/8</domain>
    </domain-config>

    <!-- Private network exception for self-hosted: allow 172.16.x.x HTTP -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">172.16.0.0/12</domain>
    </domain-config>

    <!-- Certificate pinning configuration (optional, for self-hosted with self-signed certs) -->
    <!-- 
    IMPORTANT: Certificate pinning is NOT recommended for self-hosted environments
    where organizations deploy their own certificates. Pinning would require
    different APK versions per organization.
    
    If you need pinning, implement it programmatically instead:
    - Store allowed certificate SHA256 hashes in backend API
    - Validate during connection establishment
    - Update via network calls, not hardcoded
    -->

    <!-- Self-signed certificate trust -->
    <!-- Self-signed certificates in self-hosted environments are accepted by default -->
    <!-- If you need additional CA certificates, add them in raw/network_certs directory -->
</network-security-config>
